    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst payload = body?.payload;\n\nconst errors = [];\n\nif (!body?.notificationId) {\n  errors.push('notificationId requerido');\n}\n\nif (body?.channel !== 'EMAIL') {\n  errors.push('channel debe ser EMAIL');\n}\n\nif (!payload) {\n  errors.push('payload requerido');\n}\n\nif (!Array.isArray(payload?.to) || payload.to.length === 0) {\n  errors.push('Debe tener al menos un destinatario en to');\n}\n\nif (!payload?.subject) {\n  errors.push('subject requerido');\n}\n\nif (!payload?.message && !payload?.html) {\n  errors.push('message o html requerido');\n}\n\nreturn [\n  {\n    json: {\n      valid: errors.length === 0,\n      errors,\n      body,\n      payload\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -192,
        -16
      ],
      "id": "406a7db6-84ab-44de-b2f1-edd09da4b390",
      "name": "Validar Payload"
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body ?? {};\nconst payload = body.payload ?? {};\n\nreturn {\n  json: {\n    notificationId: body.notificationId,\n    channel: body.channel,\n    email: {\n      to: payload.to ?? [],\n      cc: payload.cc ?? [],\n      bcc: payload.bcc ?? [],\n      subject: payload.subject ?? '',\n      message: payload.message ?? '',\n      html: payload.html ?? payload.message ?? '',\n      attachments: payload.attachments ?? [],\n    },\n  },\n};"
      },
