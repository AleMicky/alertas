# =============================================================================
# Variables para despliegue en VPS (copiar a .env.vps en la raíz):
#   cp .env.vps.example .env.vps
# Usado por: docker-compose.vps.yml / make vps-up
# No subir .env.vps a Git.
# =============================================================================

# ── Red Docker del VPS (donde corre infraestructura-redis) ───────────────────
DOCKER_NETWORK=infraestructura

# Database (PostgreSQL del VPS — IP, hostname o nombre de contenedor en la red)
DB_HOST=157.173.99.216
DB_PORT=5432
DB_USERNAME=notificaciones_user
DB_PASSWORD=cambia-esta-password
DB_DATABASE=dbnotificacion
DB_LOGGING=false

# Backend
NODE_ENV=production
PORT=4001
API_PREFIX=api/v1

# CORS — origen del dashboard visto desde el navegador (IP o dominio del VPS)
ALLOWED_ORIGINS=http://157.173.99.216:3000

# Timezone
TZ=America/La_Paz

# Redis (nombre del contenedor en la red Docker del VPS)
REDIS_HOST=infraestructura-redis
REDIS_PORT=6379
REDIS_PASSWORD=cambia-esta-password

# Seguridad — genera un secreto fuerte (ej. openssl rand -base64 48)
JWT_SECRET=cambia-este-jwt-secret-en-produccion
JWT_EXPIRES_IN=24h

# Webhooks (opcional)
N8N_WEBHOOK_TEST_URL=

# Frontend — URL del API accesible desde el navegador (build-time)
NEXT_PUBLIC_API_URL=http://157.173.99.216:4001/api/v1
WEB_PORT=3000

# Dashboard — credenciales iniciales (solo seeds; cámbialas después)
DASHBOARD_ADMIN_USERNAME=admin.alertas
DASHBOARD_ADMIN_PASSWORD=cambia-Admin123*
DASHBOARD_OPERATOR_USERNAME=operador.alertas
DASHBOARD_OPERATOR_PASSWORD=cambia-Operador123*
