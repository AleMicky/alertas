# =============================================================================
# Variables compartidas — copiar a .env en la raíz del monorepo:
#   cp .env.example .env
# Usadas por: docker-compose.yml, apps/api y apps/web
# =============================================================================

# Database (PostgreSQL — docker-compose + apps/api)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=dbalert
DB_LOGGING=true

# Backend (apps/api)
NODE_ENV=development
PORT=4001
API_PREFIX=api/v1

# CORS (orígenes del dashboard, separados por coma)
ALLOWED_ORIGINS=http://localhost:3000

# Timezone
TZ=America/La_Paz

# Redis (docker-compose + BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Keycloak (obligatorio — auth del dashboard)
# Issuer típico tras `make up`: http://localhost:8080/realms/alertas
KEYCLOAK_ISSUER=http://localhost:8080/realms/alertas
# Opcional; por defecto: {KEYCLOAK_ISSUER}/protocol/openid-connect/certs
KEYCLOAK_JWKS_URI=
# Audience del access token (client id del API). Vacío = no validar aud
KEYCLOAK_AUDIENCE=
# Client id para leer roles en resource_access[client].roles
KEYCLOAK_CLIENT_ID=alertas-api

# Docker Keycloak
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Webhooks de notificación (apps/api — pruebas y canales externos)
N8N_WEBHOOK_TEST_URL=http://localhost:5678/webhook/send-email

# Frontend (apps/web) — debe coincidir con PORT y API_PREFIX del backend
NEXT_PUBLIC_API_URL=http://localhost:4001/api/v1
WEB_PORT=3000

# Keycloak (apps/web — login ROPC del dashboard)
NEXT_PUBLIC_KEYCLOAK_ISSUER=http://localhost:8080/realms/alertas
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=alertas-web

# ── Docker producción local (make prod-up) ───────────────────────────────────
# DB_HOST y REDIS_HOST se sobreescriben en docker-compose.prod.yml (db / redis).
# NEXT_PUBLIC_API_URL se usa al construir la imagen del dashboard (URL accesible desde el navegador).
# En producción: ajusta KEYCLOAK_* / NEXT_PUBLIC_KEYCLOAK_* y las contraseñas del dashboard.
#
# ── VPS con Postgres/Redis externos (make vps-up) ────────────────────────────
# Usa .env.vps (ver .env.vps.example). No uses este .env local para el VPS.

# Dashboard — credenciales iniciales (solo seeds; cámbialas en producción)
DASHBOARD_ADMIN_USERNAME=admin.alertas
DASHBOARD_ADMIN_PASSWORD=Admin123*
DASHBOARD_OPERATOR_USERNAME=operador.alertas
DASHBOARD_OPERATOR_PASSWORD=Operador123*
