# =============================================================================
# Variables compartidas — copiar a .env en la raíz del monorepo:
#   cp .env.example .env
# Usadas por: docker-compose.yml, ms-alertas y dashboard-web
# =============================================================================

# Database (PostgreSQL — docker-compose + ms-alertas)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=dbalert
DB_LOGGING=true

# Backend (ms-alertas)
NODE_ENV=development
PORT=4001
API_PREFIX=api/v1

# CORS (orígenes del dashboard, separados por coma)
ALLOWED_ORIGINS=http://localhost:3000

# Timezone
TZ=America/La_Paz

# Redis (docker-compose + BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Seguridad
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=24h

# Webhooks de notificación (ms-alertas — pruebas y canales externos)
N8N_WEBHOOK_TEST_URL=http://localhost:5678/webhook/send-email

# Frontend (dashboard-web) — debe coincidir con PORT y API_PREFIX del backend
NEXT_PUBLIC_API_URL=http://localhost:4001/api/v1

# Dashboard — credenciales de desarrollo (ms-alertas)
DASHBOARD_ADMIN_USERNAME=admin.alertas
DASHBOARD_ADMIN_PASSWORD=Admin123*
DASHBOARD_OPERATOR_USERNAME=operador.alertas
DASHBOARD_OPERATOR_PASSWORD=Operador123*

# NextAuth (dashboard-web)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-in-production-nextauth-secret
