# =============================================================================
# Variables — servidor de pruebas 172.31.32.208
#   cp .env.pruebas.example .env.pruebas
# Usado por: docker-compose.pruebas.yml / make pruebas-up
# No subir .env.pruebas a Git.
# =============================================================================

# ── Red Docker (contenedores infraestructura-*) ──────────────────────────────
DOCKER_NETWORK=infraestructura

# Database (contenedor infraestructura-postgres → 172.18.0.2)
DB_HOST=infraestructura-postgres
# Alternativa por IP: DB_HOST=172.18.0.2
DB_PORT=5432
DB_USERNAME=notificaciones_user
DB_PASSWORD=cambia-esta-password
DB_DATABASE=dbnotificacion
DB_LOGGING=false

# Backend
NODE_ENV=production
PORT=4001
API_PREFIX=api/v1

# CORS — origen del dashboard en pruebas
ALLOWED_ORIGINS=http://172.31.32.208:7000

# Timezone
TZ=America/La_Paz

# Redis (contenedor infraestructura-redis → 172.18.0.6)
REDIS_HOST=infraestructura-redis
# Alternativa por IP: REDIS_HOST=172.18.0.6
REDIS_PORT=6379
REDIS_PASSWORD=cambia-esta-password

# Keycloak
# Issuer = URL pública (navegador + claim "iss" del token).
# Ajusta el puerto si Keycloak no está en :8080 del host.
KEYCLOAK_ISSUER=http://172.31.32.208:8080/realms/alertas
# JWKS interno (API → contenedor infraestructura-keycloak → 172.18.0.3)
KEYCLOAK_JWKS_URI=http://infraestructura-keycloak:8080/realms/alertas/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=
KEYCLOAK_CLIENT_ID=alertas-api

# Webhooks (opcional)
N8N_WEBHOOK_TEST_URL=

# Frontend — URLs vistas desde el navegador (build-time)
NEXT_PUBLIC_API_URL=http://172.31.32.208:4001/api/v1
WEB_PORT=7000

NEXT_PUBLIC_KEYCLOAK_ISSUER=http://172.31.32.208:8080/realms/alertas
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=alertas-web

# Dashboard — credenciales iniciales (solo seeds)
DASHBOARD_ADMIN_USERNAME=admin.alertas
DASHBOARD_ADMIN_PASSWORD=cambia-Admin123*
DASHBOARD_OPERATOR_USERNAME=operador.alertas
DASHBOARD_OPERATOR_PASSWORD=cambia-Operador123*
